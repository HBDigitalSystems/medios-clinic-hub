# Copia este archivo a .env y rellena los valores.
# Los encuentras en: Supabase Dashboard -> Project Settings -> API
#
# .env NO se versiona (ver .gitignore) porque lleva la service_role key.

# --- Publicas ---
# Con prefijo VITE_ se inyectan en el bundle del navegador. Son publicas por
# diseno: la seguridad real la dan las politicas RLS, no ocultar esta clave.
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PROJECT_ID="<project-ref>"
VITE_SUPABASE_PUBLISHABLE_KEY="<anon-key>"

# --- Servidor (SSR) ---
# Sin prefijo VITE_ a proposito: asi Vite NO las mete en el bundle del cliente.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PROJECT_ID="<project-ref>"
SUPABASE_PUBLISHABLE_KEY="<anon-key>"

# CUIDADO: se salta TODAS las politicas RLS. Solo para codigo de servidor
# (src/integrations/supabase/client.server.ts). Nunca le pongas el prefijo VITE_.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
